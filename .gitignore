#general
*.log
*.pot
*.pyc
*.docx
__pycache__/
misc/

#a local folder of source files (the flier PDFs before they were made into site/fliers/); never commit it
/static/**

#misc
.Rhistory
_meta.txt
.DS_Store

#legacy data preparation code and working data (2 GB, not part of the website)
/data-prep/

#pipeline working files (fake database, counts, maps)
/work/

#raw downloads of neighbourhood indicators (OAC, LOAC, AHAH, IMD), not redistributed
/raw-indicators/

#the real release copied out of the TRE (5 GB, about 43,000 files): never commit it. site/data/ is NOT this folder: it holds the
#small synthetic prototype release, which IS tracked, so the real release must not be copied into it
/release/

#the real release, exported from the TRE and uploaded here to build the website against: never commit it
/data/

#a scratch folder for looking at things (shapefiles and so on); never commit it
/tmp/

#SAFEGUARDED: the financial precarity classification's lookup from area to group (FPC) must never be committed, pushed or published.
#The two folders above (raw-indicators/, work/) already cover it; these rules are a second lock, in case a
#prepared table is ever written somewhere else (tools/prep_neighbourhood.py --out) or a folder is unignored.
/raw-indicators/fpc/
**/nbhd_fpc.csv
**/fpc_final*.csv
**/fpc_label*.csv

#SAFEGUARDED: the GB2C gambling classification's lookup from area to group must never be committed, pushed or published.
#Same second-lock reasoning as FPC above (its published group names and descriptions are not safeguarded).
/raw-indicators/gb2c/
**/nbhd_gb2c.csv
**/lsoa21dz22-gb2c*.csv
